  /* ---------------- boot ---------------- */
  // Nav and an initial render happen immediately and unconditionally, so the
  // tabs are always clickable even if Firebase never manages to connect.
  function boot() {
    document.getElementById("topbarDate").textContent = fmtDateShort(toDateKey(new Date()));
    window.addEventListener("error", function (e) {
      reportFatal(e && e.message ? e.message : "알 수 없는 오류");
    });
    window.addEventListener("unhandledrejection", function (e) {
      reportFatal(e && e.reason && e.reason.message ? e.reason.message : String(e.reason || "알 수 없는 오류"));
    });
    buildNav();
    render();
    connectFirebase();
    if (shouldShowNotice()) showNoticeModal();
  }

  function reportFatal(msg) {
    if (dbReady && db) return; // app is already working fine, ignore stray errors
    dbError = msg;
    dbReady = true;
    render();
  }

  async function connectFirebase() {
    if (!firebaseConfig.apiKey || firebaseConfig.apiKey.indexOf("여기에") !== -1) {
      dbError = "firebaseConfig 값이 아직 입력되지 않았어요. index.html 위쪽의 firebaseConfig 자리에 배포 가이드에서 안내한 값을 붙여넣어주세요.";
      dbReady = true;
      render();
      return;
    }
    try {
      var appMod = await import("https://www.gstatic.com/firebasejs/10.13.2/firebase-app.js");
      var fsMod = await import("https://www.gstatic.com/firebasejs/10.13.2/firebase-firestore.js");
      getFirestore = fsMod.getFirestore; doc = fsMod.doc; getDoc = fsMod.getDoc;
      setDoc = fsMod.setDoc; updateDoc = fsMod.updateDoc; deleteDoc = fsMod.deleteDoc;
      addDoc = fsMod.addDoc; collection = fsMod.collection; query = fsMod.query;
      orderBy = fsMod.orderBy; limit = fsMod.limit; onSnapshot = fsMod.onSnapshot;

      var app = appMod.initializeApp(firebaseConfig);
      db = getFirestore(app);
      dbReady = true;
      dbError = null;
      subscribeAll();
      render();
    } catch (e) {
      dbError = "Firebase 연결에 실패했어요: " + (e && e.message ? e.message : String(e));
      dbReady = true;
      db = null;
      render();
    }
  }

  function subscribeAll() {
    onSnapshot(doc(db, "config", "settings"), function (snap) {
      settings = snap.exists() ? (snap.data() || {}) : {};
      settingsLoaded = true;
      render();
    }, function (e) { reportFatal(e.message || String(e)); });

    onSnapshot(query(collection(db, "members"), orderBy("order", "asc")), function (qs) {
      members = qs.docs.map(function (d) { return Object.assign({ id: d.id }, d.data()); });
      render();
    }, function (e) { reportFatal(e.message || String(e)); });

    var todayKey = toDateKey(new Date());
    onSnapshot(doc(db, "attendance", todayKey), function (snap) {
      attendanceToday = snap.exists() ? (snap.data() || { checkedIds: [] }) : { checkedIds: [] };
      render();
    }, function (e) { reportFatal(e.message || String(e)); });

    onSnapshot(query(collection(db, "rankRecords"), orderBy("date", "desc"), limit(500)), function (qs) {
      rankRecords = qs.docs.map(function (d) { return Object.assign({ id: d.id }, d.data()); });
      render();
    }, function (e) { reportFatal(e.message || String(e)); });

    watchAdminAttendance();
  }

  function watchAdminAttendance() {
    if (adminUnsubAttendance) { adminUnsubAttendance(); adminUnsubAttendance = null; }
    if (!db) return;
    adminUnsubAttendance = onSnapshot(doc(db, "attendance", adminDate), function (snap) {
      adminAttendanceDoc = snap.exists() ? (snap.data() || { checkedIds: [] }) : { checkedIds: [] };
      if (currentTab === "admin") render();
    }, function () {});
  }

  /* ---------------- nav ---------------- */
  function buildNav() {
    var notCheckedCount = members.filter(function (m) { return (attendanceToday.checkedIds || []).indexOf(m.id) === -1; }).length;
    var weeklyMinForBadge = Number(settings.guildRankWeeklyMin || 4);
    var warnCount = members.filter(function (m) {
      return !!m.lowActivity || (m.guildRank && guildRankWeeklyCount(m.id) < weeklyMinForBadge);
    }).length;
    var badges = { attendance: notCheckedCount, warning: warnCount };

    [document.getElementById("tabrail"), document.getElementById("bottombar")].forEach(function (rail) {
      rail.innerHTML = TAB_DEFS.map(function (t) {
        var badge = badges[t.id] ? '<span class="badge">' + badges[t.id] + "</span>" : "";
        return '<button class="tabbtn' + (currentTab === t.id ? " active" : "") + '" data-tab="' + t.id + '">' + t.icon + "<span>" + t.label + "</span>" + badge + "</button>";
      }).join("");
      Array.prototype.forEach.call(rail.querySelectorAll(".tabbtn"), function (btn) {
        btn.onclick = function () { currentTab = btn.getAttribute("data-tab"); render(); };
      });
    });
  }

  /* ---------------- render dispatch ---------------- */
  function render() {
    buildNav();
    var root = document.getElementById("panelRoot");
    if (!dbReady) {
      root.innerHTML = '<div class="empty">' + ICONS.empty + '<div class="big">불러오는 중...</div></div>';
      return;
    }
    if (dbError) {
      root.innerHTML =
        '<div class="empty">' + ICONS.empty +
        '<div class="big">데이터에 연결하지 못했어요</div>' +
        "<p>" + escapeHtml(dbError) + "</p>" +
        '<p style="margin-top:14px"><button class="btn" id="retryConnBtn">다시 연결하기</button></p></div>';
      var retryBtn = document.getElementById("retryConnBtn");
      if (retryBtn) retryBtn.onclick = function () { dbError = null; dbReady = false; render(); connectFirebase(); };
      return;
    }
    if (currentTab === "attendance") root.innerHTML = renderAttendance();
    else if (currentTab === "rank") root.innerHTML = renderRank();
    else if (currentTab === "warning") root.innerHTML = renderWarning();
    else root.innerHTML = renderAdmin();
    wireTabEvents();
  }

