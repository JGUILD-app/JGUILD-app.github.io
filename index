<!doctype html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>J길드노트</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Cpath d='M24 4 L41 10 V22 C41 33 34 41 24 45 C14 41 7 33 7 22 V10 Z' fill='%23EFE9FC' stroke='%236E56CF' stroke-width='2.5'/%3E%3Cpath d='M24 15 L27 22 L34.5 22.8 L29 27.8 L30.6 35 L24 31 L17.4 35 L19 27.8 L13.5 22.8 L21 22 Z' fill='%236E56CF'/%3E%3C/svg%3E">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jua&family=Gowun+Dodum&family=JetBrains+Mono:wght@500&display=swap">
<style>
  :root {
    --bg: #F5F3FC;
    --paper: #FFFFFF;
    --paper-border: #E4DFF5;
    --rail-bg: #EDE7FB;
    --ink: #362F4D;
    --ink-soft: #6C6485;
    --ink-faint: #9C93B8;
    --accent: #6E56CF;
    --accent-ink: #FFFFFF;
    --accent-soft: #EFE9FC;
    --positive: #2FAE83;
    --positive-soft: #E1F6EE;
    --negative: #E2634F;
    --negative-soft: #FBE7E2;
    --shadow: rgba(54, 47, 77, 0.10);
    --focus: #6E56CF;
    --sky-soft: #DFEEFF;
    --gold-soft: #FFF3C4;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #1C1830; --paper: #262040; --paper-border: #3A3358; --rail-bg: #221D3B;
      --ink: #EDE9FA; --ink-soft: #B3A9D6; --ink-faint: #7C7299;
      --accent: #9C8CF0; --accent-ink: #1C1830; --accent-soft: #332A54;
      --positive: #52D1A3; --positive-soft: #1D3A30;
      --negative: #F08670; --negative-soft: #3E241F;
      --shadow: rgba(0, 0, 0, 0.45); --focus: #B3A2F7;
      --sky-soft: #1D3352; --gold-soft: #4A3E18;
    }
  }
  :root[data-theme="dark"] {
    --bg: #1C1830; --paper: #262040; --paper-border: #3A3358; --rail-bg: #221D3B;
    --ink: #EDE9FA; --ink-soft: #B3A9D6; --ink-faint: #7C7299;
    --accent: #9C8CF0; --accent-ink: #1C1830; --accent-soft: #332A54;
    --positive: #52D1A3; --positive-soft: #1D3A30;
    --negative: #F08670; --negative-soft: #3E241F;
    --shadow: rgba(0, 0, 0, 0.45); --focus: #B3A2F7;
    --sky-soft: #1D3352; --gold-soft: #4A3E18;
  }
  * { box-sizing: border-box; }
  html, body { background: var(--bg); margin: 0; }
  body {
    color: var(--ink);
    font-family: 'Gowun Dodum', 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, .display { font-family: 'Jua', 'Gowun Dodum', sans-serif; font-weight: 400; text-wrap: balance; }
  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
  button, input, select { font-family: inherit; }
  a { color: var(--accent); }

  #app { min-height: 100vh; display: flex; flex-direction: column; }

  .topbar {
    display: flex; align-items: center; gap: 12px; padding: 14px 20px;
    background: var(--paper); border-bottom: 1px solid var(--paper-border);
    position: sticky; top: 0; z-index: 20;
  }
  .crest { flex: none; width: 38px; height: 38px; }
  .brand { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-title { font-family: 'Jua', sans-serif; font-size: 20px; color: var(--accent); }
  .brand-sub { font-size: 12px; color: var(--ink-faint); }
  .topbar-date {
    margin-left: auto; font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--ink-soft);
    background: var(--accent-soft); padding: 6px 12px; border-radius: 999px; white-space: nowrap;
  }

  .layout { flex: 1; display: flex; width: 100%; max-width: 1080px; margin: 0 auto; padding: 20px; gap: 20px; }
  .tabrail {
    flex: none; width: 176px; display: flex; flex-direction: column; gap: 6px;
    background: var(--rail-bg); border: 1px solid var(--paper-border); border-radius: 18px; padding: 12px;
    height: fit-content; position: sticky; top: 84px;
  }
  .tabbtn {
    display: flex; align-items: center; gap: 10px; padding: 11px 14px; border-radius: 12px; border: none;
    background: transparent; color: var(--ink-soft); font-size: 15px; cursor: pointer; text-align: left;
    transition: background .15s ease, color .15s ease;
  }
  .tabbtn svg { flex: none; width: 20px; height: 20px; }
  .tabbtn:hover { background: var(--accent-soft); color: var(--ink); }
  .tabbtn.active { background: var(--accent); color: var(--accent-ink); font-weight: 600; }
  .tabbtn .badge {
    margin-left: auto; background: var(--negative); color: #fff; border-radius: 999px; font-size: 11px;
    min-width: 18px; height: 18px; display: inline-flex; align-items: center; justify-content: center;
    padding: 0 5px; font-family: 'JetBrains Mono', monospace;
  }
  .tabbtn.active .badge { background: rgba(255,255,255,.35); }

  .content { flex: 1; min-width: 0; }
  .panel {
    background: var(--paper); border: 1px solid var(--paper-border); border-radius: 20px; padding: 24px;
    box-shadow: 0 6px 20px var(--shadow);
  }
  .hidden { display: none !important; }
  .panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 18px; flex-wrap: wrap; }
  .panel-head h2 { margin: 0; font-size: 22px; color: var(--ink); }
  .panel-head p { margin: 4px 0 0; color: var(--ink-soft); font-size: 13.5px; }

  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px; }
  .stat-tile { background: var(--accent-soft); border-radius: 14px; padding: 14px 16px; }
  .stat-tile .num { font-family: 'Jua', sans-serif; font-size: 26px; color: var(--accent); display: block; }
  .stat-tile .label { font-size: 12.5px; color: var(--ink-soft); }
  .stat-tile.positive { background: var(--positive-soft); }
  .stat-tile.positive .num { color: var(--positive); }
  .stat-tile.negative { background: var(--negative-soft); }
  .stat-tile.negative .num { color: var(--negative); }

  .chip-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .chip {
    display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 14px;
    border: 1.5px dashed var(--negative); background: var(--negative-soft);
  }
  .chip.checked { border-style: solid; border-color: var(--positive); background: var(--positive-soft); }
  .chip .avatar {
    flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--accent); color: var(--accent-ink);
    display: flex; align-items: center; justify-content: center; font-family: 'Jua', sans-serif; font-size: 14px;
  }
  .chip .name { font-size: 14.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .chip .tag { margin-left: auto; font-size: 11px; color: var(--negative); flex: none; }
  .chip.checked .tag { color: var(--positive); }

  .empty { text-align: center; padding: 40px 20px; color: var(--ink-soft); }
  .empty svg { width: 56px; height: 56px; color: var(--ink-faint); margin-bottom: 10px; }
  .empty .big { font-family: 'Jua', sans-serif; font-size: 17px; color: var(--ink); margin-bottom: 4px; }

  .rank-list { display: flex; flex-direction: column; gap: 10px; }
  .rank-row {
    display: grid; grid-template-columns: 34px 1fr auto auto; align-items: center; gap: 12px;
    padding: 12px 14px; border: 1px solid var(--paper-border); border-radius: 14px;
  }
  .rank-row .avatar {
    width: 30px; height: 30px; border-radius: 50%; background: var(--accent); color: var(--accent-ink);
    display: flex; align-items: center; justify-content: center; font-family: 'Jua', sans-serif; font-size: 13px;
  }
  .rank-row .who .rname { font-weight: 600; }
  .rank-row .who .rmeta { font-size: 12px; color: var(--ink-faint); }
  .rank-row .wl { font-family: 'JetBrains Mono', monospace; font-size: 13px; text-align: right; }
  .rank-row .wl b.w { color: var(--positive); }
  .rank-row .wl b.l { color: var(--negative); }
  .stamp-row { display: flex; gap: 4px; justify-content: flex-end; }
  .stamp {
    width: 25px; height: 25px; border-radius: 50%; background: var(--paper);
    border: 2px solid var(--positive); color: var(--positive);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Jua', sans-serif; font-size: 11px; flex: none;
  }
  .stamp.loss { border-color: var(--negative); color: var(--negative); }
  .rank-row.hl-sky { background: var(--sky-soft); }
  .rank-row.hl-gold { background: var(--gold-soft); }
  .rank-legend { display: flex; gap: 14px; flex-wrap: wrap; margin: 2px 0 0; }
  .rank-legend span { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; color: var(--ink-soft); }
  .rank-legend i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
  .rank-legend i.sky { background: var(--sky-soft); }
  .rank-legend i.gold { background: var(--gold-soft); }

  .section { margin-bottom: 26px; }
  .section h3 { font-size: 16px; margin: 0 0 4px; color: var(--ink); }
  .section .hint { font-size: 12.5px; color: var(--ink-faint); margin: 0 0 12px; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  input[type="text"], input[type="password"], input[type="number"], input[type="date"], select {
    background: var(--bg); border: 1.5px solid var(--paper-border); color: var(--ink); border-radius: 10px;
    padding: 9px 12px; font-size: 14px; outline: none;
  }
  input:focus, select:focus { border-color: var(--focus); }
  .btn {
    display: inline-flex; align-items: center; gap: 6px; background: var(--accent); color: var(--accent-ink);
    border: none; border-radius: 10px; padding: 9px 16px; font-size: 14px; font-weight: 600; cursor: pointer;
  }
  .btn:hover { filter: brightness(1.06); }
  .btn.ghost { background: transparent; color: var(--ink-soft); border: 1.5px solid var(--paper-border); }
  .btn.danger { background: var(--negative); }
  .btn.small { padding: 6px 11px; font-size: 12.5px; border-radius: 8px; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--paper-border); border-radius: 14px; }
  table { width: 100%; border-collapse: collapse; font-size: 13.5px; min-width: 480px; }
  th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--paper-border); white-space: nowrap; }
  th { color: var(--ink-faint); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  tr:last-child td { border-bottom: none; }
  td input[type="number"] { width: 72px; }
  td input[type="text"] { width: 120px; }

  .toggle-chip {
    display: inline-flex; align-items: center; gap: 8px; padding: 9px 12px; border-radius: 12px; cursor: pointer;
    user-select: none; border: 1.5px dashed var(--negative); background: var(--negative-soft);
  }
  .toggle-chip.on { border-style: solid; border-color: var(--positive); background: var(--positive-soft); }
  .toggle-chip .dotstate { width: 9px; height: 9px; border-radius: 50%; background: var(--negative); flex: none; }
  .toggle-chip.on .dotstate { background: var(--positive); }

  .lockbox { max-width: 340px; margin: 30px auto; text-align: center; }
  .lockbox svg { width: 44px; height: 44px; color: var(--accent); margin-bottom: 10px; }
  .lockbox .err { color: var(--negative); font-size: 13px; min-height: 18px; margin-top: 8px; }
  .lockbox form { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }

  #toastRoot { position: fixed; bottom: 90px; left: 50%; transform: translateX(-50%); z-index: 100; display: flex; flex-direction: column; gap: 8px; align-items: center; }
  .toast { background: var(--ink); color: var(--bg); padding: 10px 18px; border-radius: 999px; font-size: 13.5px; box-shadow: 0 6px 18px var(--shadow); }
  #modalRoot { position: fixed; inset: 0; z-index: 200; pointer-events: none; }
  .modal-back { position: absolute; inset: 0; background: rgba(20, 16, 36, .45); display: flex; align-items: center; justify-content: center; padding: 20px; pointer-events: auto; }
  .modal-card { background: var(--paper); border-radius: 18px; padding: 22px; max-width: 320px; width: 100%; box-shadow: 0 12px 30px var(--shadow); }
  .modal-card p { color: var(--ink); font-size: 14.5px; margin: 0 0 16px; }
  .modal-actions { display: flex; gap: 8px; justify-content: flex-end; }

  .notice-card { max-width: 380px; text-align: left; }
  .notice-title { margin: 0 0 10px; font-size: 18px; color: var(--accent); }
  .notice-card p { line-height: 1.65; }
  .notice-copyright { font-size: 12px; color: var(--ink-faint) !important; margin-top: -6px !important; }
  .notice-checkbox { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink-soft); margin: 16px 0 16px; cursor: pointer; user-select: none; }
  .notice-checkbox input { accent-color: var(--accent); width: 16px; height: 16px; }

  .minicheck { display: inline-flex; align-items: center; gap: 5px; font-size: 12.5px; color: var(--ink-soft); cursor: pointer; user-select: none; white-space: nowrap; }
  .minicheck input { accent-color: var(--accent); width: 14px; height: 14px; }
  .typecell { display: flex; flex-direction: column; gap: 4px; white-space: normal !important; }
  .tag-badge { display: inline-flex; align-items: center; font-size: 11px; padding: 2px 7px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); margin-right: 4px; }

  .bottombar {
    display: none; position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
    background: var(--paper); border-top: 1px solid var(--paper-border);
    padding: 6px 4px calc(6px + env(safe-area-inset-bottom)); justify-content: space-around;
  }
  .bottombar .tabbtn { flex-direction: column; gap: 3px; font-size: 10.5px; padding: 6px 4px; border-radius: 10px; flex: 1; align-items: center; position: relative; }
  .bottombar .tabbtn .badge { position: absolute; margin-left: 14px; margin-top: -14px; }

  .setupNotice { background: var(--negative-soft); color: var(--negative); border-radius: 12px; padding: 12px 16px; font-size: 13px; margin: 14px 20px 0; }

  @media (max-width: 760px) {
    .tabrail { display: none; }
    .bottombar { display: flex; }
    .layout { padding: 14px; padding-bottom: 84px; }
    .panel { padding: 18px; border-radius: 16px; }
    .stats { grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .stat-tile { padding: 10px 10px; }
    .stat-tile .num { font-size: 21px; }
    .topbar-date { display: none; }
    .brand-sub { display: none; }
    .rank-row { grid-template-columns: 28px 1fr auto auto; gap: 8px; }
    .stamp-row { gap: 2px; }
    .stamp { width: 18px; height: 18px; font-size: 8px; border-width: 1.5px; }
  }
</style>
</head>
<body>

<div id="app">
  <header class="topbar">
    <svg class="crest" viewBox="0 0 48 48" fill="none">
      <path d="M24 4 L41 10 V22 C41 33 34 41 24 45 C14 41 7 33 7 22 V10 Z" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="2.5" stroke-linejoin="round"/>
      <path d="M24 15 L27 22 L34.5 22.8 L29 27.8 L30.6 35 L24 31 L17.4 35 L19 27.8 L13.5 22.8 L21 22 Z" fill="var(--accent)"/>
    </svg>
    <div class="brand">
      <span class="brand-title">J길드노트</span>
      <span class="brand-sub">우리 길드 출석 · 랭크 기록장</span>
    </div>
    <span class="topbar-date mono" id="topbarDate">-</span>
  </header>

  <div class="layout">
    <nav class="tabrail" id="tabrail"></nav>
    <main class="content">
      <section class="panel" id="panelRoot"><div class="empty">불러오는 중...</div></section>
    </main>
  </div>

  <nav class="bottombar" id="bottombar"></nav>
</div>
<div id="toastRoot"></div>
<div id="modalRoot"></div>

<script type="module">
  /* =========================================================================
     길드노트 - Firebase 설정
     아래 firebaseConfig 자리에 Firebase 콘솔에서 복사한 값을 붙여넣으세요.
     (같이 드린 "배포 가이드" 문서의 3단계를 참고하세요)
     ========================================================================= */
  const firebaseConfig = {
    apiKey: "AIzaSyC5nVT-xuOjcL8QbAp-lCquqyDJ7lCfp5A",
    authDomain: "j-note-97b99.firebaseapp.com",
    projectId: "j-note-97b99",
    storageBucket: "j-note-97b99.firebasestorage.app",
    messagingSenderId: "845128990567",
    appId: "1:845128990567:web:67d583a16bf0d6a55279c2"
  };
  /* ========================================================================= */

  /* Firebase SDK is loaded dynamically inside connectFirebase() below, wrapped
     in try/catch, so a network hiccup or bad config shows a clear on-page
     error instead of silently freezing the whole app. */
  var getFirestore, doc, getDoc, setDoc, updateDoc, deleteDoc, addDoc,
    collection, query, orderBy, limit, onSnapshot;
  var db = null, dbReady = false, dbError = null;

  /* ---------------- icons ---------------- */
  var ICONS = {
    attendance: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="17" rx="2.5"/><path d="M9 3.5h6v2.4a1 1 0 0 1-1 1H10a1 1 0 0 1-1-1z" fill="currentColor" stroke="none"/><path d="M8.5 13.5l2.4 2.4L15.7 11"/></svg>',
    rank: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4h8v5a4 4 0 0 1-8 0z"/><path d="M8 5H5a1 1 0 0 0-1 1c0 2.2 1.6 4 3.6 4.3"/><path d="M16 5h3a1 1 0 0 1 1 1c0 2.2-1.6 4-3.6 4.3"/><path d="M12 13v3"/><path d="M9 20h6"/><path d="M9.5 20c0-1.7.9-2.6 2.5-2.6s2.5.9 2.5 2.6"/></svg>',
    warning: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5 21.5 20h-19z"/><path d="M12 10v4.5"/><circle cx="12" cy="17.3" r="0.9" fill="currentColor" stroke="none"/></svg>',
    admin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.2"/><path d="M19.4 13.5a7.6 7.6 0 0 0 0-3l2-1.4-2-3.4-2.3.8a7.6 7.6 0 0 0-2.6-1.5L14 2.5h-4l-.5 2.5a7.6 7.6 0 0 0-2.6 1.5l-2.3-.8-2 3.4 2 1.4a7.6 7.6 0 0 0 0 3l-2 1.4 2 3.4 2.3-.8a7.6 7.6 0 0 0 2.6 1.5l.5 2.5h4l.5-2.5a7.6 7.6 0 0 0 2.6-1.5l2.3.8 2-3.4z"/></svg>',
    lock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2.2"/><path d="M8 11V7.5a4 4 0 0 1 8 0V11"/></svg>',
    empty: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V7a2 2 0 0 1 2-2h6l2 2h6a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/></svg>',
    check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>'
  };
  var TAB_DEFS = [
    { id: "attendance", label: "출석체크", icon: ICONS.attendance },
    { id: "rank", label: "길드 랭크", icon: ICONS.rank },
    { id: "warning", label: "경고 · 주의", icon: ICONS.warning },
    { id: "admin", label: "관리", icon: ICONS.admin }
  ];

  /* ---------------- state ---------------- */
  var currentTab = "attendance";
  var members = [];
  var settings = {};
  var settingsLoaded = false;
  var attendanceToday = { checkedIds: [] };
  var rankRecords = [];
  var isAdmin = false;
  var adminDate = toDateKey(new Date());
  var adminAttendanceDoc = { checkedIds: [] };
  var adminUnsubAttendance = null;

  try { isAdmin = sessionStorage.getItem("gn_admin") === "1"; } catch (e) {}

  /* ---------------- helpers ---------------- */
  function toDateKey(d) {
    var y = d.getFullYear(), m = String(d.getMonth() + 1).padStart(2, "0"), day = String(d.getDate()).padStart(2, "0");
    return y + "-" + m + "-" + day;
  }
  function escapeHtml(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }
  function initials(name) { var s = (name || "").trim(); return s ? s.slice(0, 1) : "?"; }
  function fmtDateLong(dateKey) {
    var d = new Date(dateKey + "T00:00:00");
    if (isNaN(d)) return dateKey;
    return new Intl.DateTimeFormat("ko-KR", { year: "numeric", month: "long", day: "numeric", weekday: "short" }).format(d);
  }
  function fmtDateShort(dateKey) {
    var d = new Date(dateKey + "T00:00:00");
    if (isNaN(d)) return dateKey;
    return new Intl.DateTimeFormat("ko-KR", { month: "2-digit", day: "2-digit" }).format(d);
  }
  function toast(msg) {
    var root = document.getElementById("toastRoot");
    var el = document.createElement("div");
    el.className = "toast"; el.textContent = msg;
    root.appendChild(el);
    setTimeout(function () { el.remove(); }, 2200);
  }
  function confirmDialog(message, okLabel) {
    return new Promise(function (resolve) {
      var root = document.getElementById("modalRoot");
      root.innerHTML =
        '<div class="modal-back"><div class="modal-card">' +
        "<p>" + escapeHtml(message) + "</p>" +
        '<div class="modal-actions">' +
        '<button class="btn ghost" data-act="no">취소</button>' +
        '<button class="btn danger" data-act="yes">' + escapeHtml(okLabel || "확인") + "</button>" +
        "</div></div></div>";
      root.querySelector('[data-act="no"]').onclick = function () { root.innerHTML = ""; resolve(false); };
      root.querySelector('[data-act="yes"]').onclick = function () { root.innerHTML = ""; resolve(true); };
      root.querySelector(".modal-back").addEventListener("click", function (e) {
        if (e.target.classList.contains("modal-back")) { root.innerHTML = ""; resolve(false); }
      });
    });
  }
  function memberById(id) { for (var i = 0; i < members.length; i++) if (members[i].id === id) return members[i]; return null; }
  function weekStartKey(d) {
    var day = d.getDay();
    var diff = day === 0 ? -6 : 1 - day;
    var monday = new Date(d.getFullYear(), d.getMonth(), d.getDate() + diff);
    return toDateKey(monday);
  }
  function guildRankWeeklyCount(memberId) {
    var wk = weekStartKey(new Date());
    var n = 0;
    for (var i = 0; i < rankRecords.length; i++) {
      if (rankRecords[i].memberId === memberId && rankRecords[i].date >= wk) n++;
    }
    return n;
  }
  function weekOfMonthLabel(d) {
    var year = d.getFullYear(), mon = d.getMonth();
    var firstDow = new Date(year, mon, 1).getDay();
    var firstMonday = new Date(year, mon, 1 - ((firstDow + 6) % 7));
    var diffDays = Math.round((new Date(year, mon, d.getDate()) - firstMonday) / 86400000);
    var week = Math.floor(diffDays / 7) + 1;
    return (mon + 1) + "월 " + week + "주차";
  }

