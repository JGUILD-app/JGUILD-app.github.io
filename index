  /* ---------------- rank tab ---------------- */
  function renderRank() {
    var byMember = {};
    var weekStart = weekStartKey(new Date());
    rankRecords.forEach(function (r) {
      var key = r.memberId || r.memberName;
      if (!byMember[key]) byMember[key] = { key: key, name: r.memberName, wins: 0, losses: 0, last: r.date, recent: [], weekCount: 0 };
      if (r.date >= weekStart) byMember[key].weekCount++;
      if (r.result === "win") byMember[key].wins++; else byMember[key].losses++;
      if (!byMember[key].last || r.date > byMember[key].last) byMember[key].last = r.date;
      byMember[key].recent.push(r);
    });
    var list = Object.keys(byMember).map(function (k) { return byMember[k]; });
    list.forEach(function (p) { p.recent.sort(function (a, b) { return b.date < a.date ? -1 : 1; }); p.recent = p.recent.slice(0, 7); });
    list.sort(function (a, b) { return (b.wins - b.losses) - (a.wins - a.losses); });

    var totalWins = list.reduce(function (s, p) { return s + p.wins; }, 0);
    var totalLosses = list.reduce(function (s, p) { return s + p.losses; }, 0);
    var totalGames = totalWins + totalLosses;
    var winRate = totalGames ? Math.round((totalWins / totalGames) * 100) : 0;

    var body;
    if (list.length === 0) {
      body = emptyState("아직 랭크 기록이 없어요", "관리 탭에서 길드 랭크 결과를 입력하면 여기에 표시돼요.");
    } else {
      body = '<div class="rank-list">' + list.map(function (p) {
        var games = p.wins + p.losses;
        var rate = games ? Math.round((p.wins / games) * 100) : 0;
        var oldestFirst = p.recent.slice().reverse();
        var stamps = oldestFirst.map(function (r) {
          return '<span class="stamp' + (r.result === "loss" ? " loss" : "") + '">' + (r.result === "loss" ? "패" : "승") + "</span>";
        }).join("");
        var hlClass = p.weekCount >= 7 ? " hl-gold" : p.weekCount >= 5 ? " hl-sky" : "";
        return (
          '<div class="rank-row' + hlClass + '">' +
          '<span class="avatar">' + escapeHtml(initials(p.name)) + "</span>" +
          '<div class="who"><div class="rname">' + escapeHtml(p.name || "(이름없음)") + '</div><div class="rmeta">최근 참여 ' + fmtDateShort(p.last) + "</div></div>" +
          '<div class="stamp-row">' + stamps + "</div>" +
          '<div class="wl"><b class="w">' + p.wins + "승</b> <b class=\"l\">" + p.losses + "패</b><br><span style=\"color:var(--ink-faint)\">승률 " + rate + "%</span></div>" +
          "</div>"
        );
      }).join("") + "</div>";
    }

    return (
      '<div class="panel-head"><div><h2>길드 랭크</h2>' +
      "<p>" + fmtDateLong(toDateKey(new Date())) + " · " + weekOfMonthLabel(new Date()) + " (월~일 기준)</p>" +
      '<div class="rank-legend"><span><i class="sky"></i>이번 주 5회 이상 참여</span><span><i class="gold"></i>이번 주 7회 참여</span></div>' +
      "</div></div>" +
      '<div class="stats">' +
      statTile(list.length, "참여 인원", "") +
      statTile(totalWins + "승 " + totalLosses + "패", "전체 전적", "") +
      statTile(winRate + "%", "전체 승률", "positive") +
      "</div>" + body
    );
  }

