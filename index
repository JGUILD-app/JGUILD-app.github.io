    }).join("");

    var memberOptions = members.map(function (m) { return '<option value="' + m.id + '">' + escapeHtml(m.name) + "</option>"; }).join("");

    var weeklyMinNow = Number(settings.guildRankWeeklyMin || 4);
    var guildRankStatusRows = guildRankMembersList.map(function (m) {
      var n = guildRankWeeklyCount(m.id);
      var low = n < weeklyMinNow;
      return "<tr><td>" + escapeHtml(m.name) + '</td><td class="mono"' + (low ? ' style="color:var(--negative)"' : ' style="color:var(--positive)"') + ">" + n + " / " + weeklyMinNow + "</td></tr>";
    }).join("");

    var recentRecords = rankRecords.slice(0, 20).map(function (r) {
      return (
        "<tr><td>" + fmtDateShort(r.date) + "</td><td>" + escapeHtml(r.memberName || "") + "</td>" +
        '<td>' + (r.result === "win" ? '<span style="color:var(--positive)">승</span>' : '<span style="color:var(--negative)">패</span>') + "</td>" +
        '<td><button class="btn ghost small" data-role="rdelete" data-id="' + r.id + '">삭제</button></td></tr>'
      );
    }).join("");

    return (
      '<div class="panel-head"><div><h2>관리</h2><p>길드원 · 출석 · 랭크 · 활동 포인트를 관리해요.</p></div>' +
      '<button class="btn ghost small" id="logoutBtn">로그아웃</button></div>' +

      '<div class="section">' +
      "<h3>새 길드원 추가</h3><p class=\"hint\">이름과 유형을 선택해서 추가하세요. 유형은 아래 목록에서 나중에도 바꿀 수 있어요.</p>" +
      '<div class="row">' +
      '<input type="text" id="newMemberName" placeholder="새 길드원 이름">' +
      '<label class="minicheck"><input type="checkbox" id="newMemberRepute">명성 유저</label>' +
      '<label class="minicheck"><input type="checkbox" id="newMemberGuildRank">길랭 유저</label>' +
      '<button class="btn" id="addMemberBtn">추가</button>' +
      "</div>" +
      "</div>" +

      '<div class="section">' +
      "<h3>명성 유저</h3><p class=\"hint\">이름 · 활동 포인트는 입력 후 바로 저장돼요. 활동 포인트 경고는 버튼으로 직접 지정하세요.</p>" +
      (reputeMembersList.length ? '<div class="table-wrap"><table>' + memberTableHead + "<tbody>" + reputeMemberRows + "</tbody></table></div>" : '<p class="hint">등록된 명성 유저가 없어요.</p>') +
      "</div>" +

      '<div class="section">' +
      "<h3>길랭 유저</h3><p class=\"hint\">이번 주 참여 현황과 경고 기준은 아래 '길랭 경고 기준'에서 확인 · 설정할 수 있어요.</p>" +
      (guildRankMembersList.length ? '<div class="table-wrap"><table>' + memberTableHeadNoWarn + "<tbody>" + guildRankMemberRows + "</tbody></table></div>" : '<p class="hint">등록된 길랭 유저가 없어요.</p>') +
      "</div>" +

      (unclassifiedMembersList.length ? (
        '<div class="section">' +
        "<h3>유형 미지정 길드원</h3><p class=\"hint\">명성 · 길랭 어느 쪽에도 체크되지 않은 길드원이에요.</p>" +
        '<div class="table-wrap"><table>' + memberTableHead + "<tbody>" + unclassifiedMemberRows + "</tbody></table></div>" +
        "</div>"
      ) : "") +

      '<div class="section">' +
      "<h3>길랭 경고 기준</h3><p class=\"hint\">이번 주 길드 랭크 참여 횟수가 이 숫자보다 적은 길랭 유저가 경고 · 주의 탭에 자동으로 표시돼요.</p>" +
      '<div class="row" style="margin-bottom:14px"><input type="number" id="weeklyMinInput" value="' + Number(settings.guildRankWeeklyMin || 4) + '"><span class="hint" style="margin:0">회 / 주</span><button class="btn" id="saveWeeklyMinBtn">저장</button></div>' +
      (guildRankMembersList.length ? '<div class="table-wrap"><table><thead><tr><th>길드원</th><th>이번 주 길랭 횟수</th></tr></thead><tbody>' + guildRankStatusRows + "</tbody></table></div>" : '<p class="hint">길랭 유저로 지정된 길드원이 없어요.</p>') +
      "</div>" +

      '<div class="section">' +
      "<h3>출석체크 처리</h3><p class=\"hint\">날짜를 고르고 출석한 길드원을 눌러 표시하세요.</p>" +
      '<div class="row" style="margin-bottom:12px"><input type="date" id="adminDatePick" value="' + adminDate + '"></div>' +
      (members.length ? '<div class="chip-grid">' + attendanceChips + "</div>" : '<p class="hint">등록된 길드원이 없어요.</p>') +
      "</div>" +

      '<div class="section">' +
      "<h3>길드 랭크 기록 추가</h3><p class=\"hint\">길드원, 날짜, 승패 결과를 입력해 기록을 남기세요.</p>" +
      '<div class="row" style="margin-bottom:12px">' +
      '<select id="rankMember">' + (memberOptions || "<option value=\"\">길드원 없음</option>") + "</select>" +
      '<input type="date" id="rankDate" value="' + toDateKey(new Date()) + '">' +
      '<select id="rankResult"><option value="win">승</option><option value="loss">패</option></select>' +
      '<button class="btn" id="addRankBtn">기록 추가</button>' +
      "</div>" +
      (recentRecords ? '<div class="table-wrap"><table><thead><tr><th>날짜</th><th>길드원</th><th>결과</th><th></th></tr></thead><tbody>' + recentRecords + "</tbody></table></div>" : '<p class="hint">아직 기록이 없어요.</p>') +
      "</div>" +

      '<div class="section">' +
      "<h3>관리자 비밀번호 변경</h3>" +
      '<div class="row"><input type="password" id="newPwInput" placeholder="새 비밀번호"><button class="btn ghost" id="changePwBtn">변경</button></div>' +
      "</div>"
    );
  }

  /* ---------------- small render helpers ---------------- */
  function statTile(num, label, tone) {
    return '<div class="stat-tile' + (tone ? " " + tone : "") + '"><span class="num">' + num + "</span><span class=\"label\">" + label + "</span></div>";
  }
  function emptyState(big, small, icon) {
    return '<div class="empty">' + (icon || ICONS.empty) + '<div class="big">' + big + "</div><p>" + small + "</p></div>";
  }

  /* ---------------- event wiring per render ---------------- */
  function wireTabEvents() {
    if (currentTab !== "admin") return;

    var setupForm = document.getElementById("setupForm");
    if (setupForm) {
      setupForm.onsubmit = async function (e) {
        e.preventDefault();
        var pw = document.getElementById("setupPw").value;
        var pw2 = document.getElementById("setupPw2").value;
        var err = document.getElementById("setupErr");
        if (pw.length < 4) { err.textContent = "비밀번호는 4자 이상으로 만들어주세요."; return; }
        if (pw !== pw2) { err.textContent = "비밀번호가 서로 달라요."; return; }
        await setDoc(doc(db, "config", "settings"), Object.assign({}, settings, { adminPassword: pw }));
        isAdmin = true;
        try { sessionStorage.setItem("gn_admin", "1"); } catch (ex) {}
        toast("관리자 비밀번호가 설정되었어요");
      };
    }

    var loginForm = document.getElementById("loginForm");
    if (loginForm) {
      loginForm.onsubmit = function (e) {
        e.preventDefault();
        var pw = document.getElementById("loginPw").value;
        var err = document.getElementById("loginErr");
        if (pw === settings.adminPassword) {
          isAdmin = true;
          try { sessionStorage.setItem("gn_admin", "1"); } catch (ex) {}
          render();
        } else {
          err.textContent = "비밀번호가 올바르지 않아요.";
        }
      };
    }

    var logoutBtn = document.getElementById("logoutBtn");
    if (logoutBtn) logoutBtn.onclick = function () {
      isAdmin = false;
      try { sessionStorage.removeItem("gn_admin"); } catch (ex) {}
      render();
    };

    var addMemberBtn = document.getElementById("addMemberBtn");
    if (addMemberBtn) addMemberBtn.onclick = async function () {
      var input = document.getElementById("newMemberName");
      var reputeChk = document.getElementById("newMemberRepute");
      var guildRankChk = document.getElementById("newMemberGuildRank");
      var name = input.value.trim();
      if (!name) return;
      var id = "m_" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
      await setDoc(doc(db, "members", id), {
        name: name, points: 0, order: Date.now(),
        repute: !!(reputeChk && reputeChk.checked),
        guildRank: !!(guildRankChk && guildRankChk.checked),
        lowActivity: false
      });
      input.value = "";
      if (reputeChk) reputeChk.checked = false;
      if (guildRankChk) guildRankChk.checked = false;
      toast(name + " 님을 추가했어요");
    };

    Array.prototype.forEach.call(document.querySelectorAll('[data-role="mname"]'), function (el) {
      el.onchange = async function () {
        await updateDoc(doc(db, "members", el.getAttribute("data-id")), { name: el.value.trim() || "(이름없음)" });
        toast("이름을 저장했어요");
      };
    });
    Array.prototype.forEach.call(document.querySelectorAll('[data-role="mpoints"]'), function (el) {
      el.onchange = async function () {
        await updateDoc(doc(db, "members", el.getAttribute("data-id")), { points: Number(el.value) || 0 });
        toast("활동 포인트를 저장했어요");
      };
    });
    Array.prototype.forEach.call(document.querySelectorAll('[data-role="mdelete"]'), function (el) {
      el.onclick = async function () {
        var m = memberById(el.getAttribute("data-id"));
        var ok = await confirmDialog((m ? m.name : "이 길드원") + " 님을 삭제할까요? 출석 · 랭크 기록은 남아있어요.", "삭제");
        if (!ok) return;
        await deleteDoc(doc(db, "members", el.getAttribute("data-id")));
        toast("삭제했어요");
      };
    });
    Array.prototype.forEach.call(document.querySelectorAll('[data-role="mrepute"]'), function (el) {
      el.onchange = async function () {
        await updateDoc(doc(db, "members", el.getAttribute("data-id")), { repute: el.checked });
      };
    });
    Array.prototype.forEach.call(document.querySelectorAll('[data-role="mguildrank"]'), function (el) {
      el.onchange = async function () {
        await updateDoc(doc(db, "members", el.getAttribute("data-id")), { guildRank: el.checked });
      };
    });
    Array.prototype.forEach.call(document.querySelectorAll('[data-role="mlowtoggle"]'), function (el) {
      el.onclick = async function () {
        var m = memberById(el.getAttribute("data-id"));
        var next = !(m && m.lowActivity);
        await updateDoc(doc(db, "members", el.getAttribute("data-id")), { lowActivity: next });
        toast(next ? "경고 대상으로 지정했어요" : "경고 대상에서 해제했어요");
      };
    });

    var adminDatePick = document.getElementById("adminDatePick");
    if (adminDatePick) adminDatePick.onchange = function () {
      adminDate = adminDatePick.value || toDateKey(new Date());
      watchAdminAttendance();
      render();
    };
    Array.prototype.forEach.call(document.querySelectorAll('[data-role="toggleatt"]'), function (el) {
      el.onclick = async function () {
        var id = el.getAttribute("data-id");
        var ref = doc(db, "attendance", adminDate);
        var snap = await getDoc(ref);
        var ids = (snap.exists() && snap.data().checkedIds) || [];
        var idx = ids.indexOf(id);
        if (idx === -1) ids = ids.concat([id]); else { ids = ids.slice(); ids.splice(idx, 1); }
        await setDoc(ref, { checkedIds: ids });
      };
    });

    var addRankBtn = document.getElementById("addRankBtn");
    if (addRankBtn) addRankBtn.onclick = async function () {
      var memberSel = document.getElementById("rankMember");
      var dateInput = document.getElementById("rankDate");
      var resultSel = document.getElementById("rankResult");
      if (!memberSel.value) { toast("먼저 길드원을 등록해주세요"); return; }
      var m = memberById(memberSel.value);
      await addDoc(collection(db, "rankRecords"), {
        memberId: memberSel.value,
        memberName: m ? m.name : "(이름없음)",
        date: dateInput.value || toDateKey(new Date()),
        result: resultSel.value,
        createdAt: Date.now()
      });
      toast("기록을 추가했어요");
    };
    Array.prototype.forEach.call(document.querySelectorAll('[data-role="rdelete"]'), function (el) {
      el.onclick = async function () {
        var ok = await confirmDialog("이 랭크 기록을 삭제할까요?", "삭제");
        if (!ok) return;
        await deleteDoc(doc(db, "rankRecords", el.getAttribute("data-id")));
        toast("삭제했어요");
      };
    });

    var saveWeeklyMinBtn = document.getElementById("saveWeeklyMinBtn");
    if (saveWeeklyMinBtn) saveWeeklyMinBtn.onclick = async function () {
      var val = Number(document.getElementById("weeklyMinInput").value) || 0;
      await updateDoc(doc(db, "config", "settings"), { guildRankWeeklyMin: val });
      toast("길랭 경고 기준을 저장했어요");
    };

    var changePwBtn = document.getElementById("changePwBtn");
    if (changePwBtn) changePwBtn.onclick = async function () {
      var val = document.getElementById("newPwInput").value;
      if (val.length < 4) { toast("비밀번호는 4자 이상으로 해주세요"); return; }
      await updateDoc(doc(db, "config", "settings"), { adminPassword: val });
      document.getElementById("newPwInput").value = "";
      toast("비밀번호를 변경했어요");
    };
  }

  boot();
</script>
</body>
</html>
